# Copy to .env on the host and fill in. .env is gitignored — never commit the real one.
#
# This file is the single source of truth for every startup/fallback setting the
# backend reads. application.yml never hardcodes a value — it only does
# ${VAR:default} against what's below. Frontend needs none of this: it's a static
# build that talks to the backend same-origin, no VITE_ vars, no keys in the bundle.
#
# LLM keys are the one exception with a second home: an admin can override
# provider/keys/models at runtime via /admin (stored encrypted in Postgres). A blank
# value there falls back to what's set here. Everything else below has no DB override
# — this file (or the real env vars on the host) is the only place it's set.

# --- Cloudflare Tunnel ---
# From Zero Trust dashboard > Networks > Tunnels > your tunnel > install command.
# This token is a credential: anyone holding it can publish traffic as your tunnel.
TUNNEL_TOKEN=

# --- CORS / cookies ---
# Exact scheme+host of the Vercel deployment. No trailing slash.
FRONTEND_ORIGIN=https://resuforge.example.com
# Lax is only safe while frontend and backend share a registrable domain.
# On a *.vercel.app frontend this must become None, and SecurityConfig's
# .csrf(disable) then leaves the API open to cross-site requests.
COOKIE_SAME_SITE=Lax
# True even though cloudflared talks plain HTTP to the app — Cloudflare
# terminates TLS at the edge, so the browser only ever sees https.
COOKIE_SECURE=true

# --- Neon ---
# Direct endpoint, NOT -pooler (see application.yml comment).
DB_URL=jdbc:postgresql://<endpoint>.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=

# --- LLM ---
# Fallbacks only — the live provider and keys are managed by an admin at /admin.
# A blank setting in the DB falls back to the value here.
LLM_PROVIDER=gemini

# Encrypts the provider API keys stored in the database. Without it the app runs on
# the keys below but refuses to save new ones rather than storing them in plaintext.
# Generate: openssl rand -base64 32
LLM_SECRET_KEY=
GEMINI_API_KEY=

# OpenCode Zen (OpenAI-compatible). Models optional — see application.yml for
# the defaults. Valid ids: curl https://opencode.ai/zen/v1/models
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL_GENERATE=x-preview-f-free
OPENCODE_MODEL_MATCH=x-preview-f-free
OPENCODE_MODEL_CLEAN_JD=deepseek-v4-flash-free

# OpenAI-compatible (also OpenRouter, Ollama, LM Studio — anything with /chat/completions).
# Not offered as an admin default in the UI hint above but the column/env both exist.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- PDF rendering ---
# tectonic binary on PATH, or an absolute path to it.
TECTONIC_BIN=tectonic

# --- Seed user ---
# SeedUserRunner creates this on first boot. Blank password = no seed user.
SEED_USERNAME=f3l
SEED_EMAIL=admin@localhost
SEED_PASSWORD=
